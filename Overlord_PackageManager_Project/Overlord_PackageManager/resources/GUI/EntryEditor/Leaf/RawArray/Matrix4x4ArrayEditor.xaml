<UserControl x:Class="Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.RawArray.Matrix4x4ArrayEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar">

    <UserControl.Resources>
        <Style x:Key="ClusterBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Matrix 4x4 Array"
                               FontWeight="Bold"
                               FontSize="16" />
                    <Button Content="+ Add Cluster"
                            Width="120"
                            Margin="20,0,0,0"
                            Click="AddButton_Click" />
                </StackPanel>

                <ItemsControl x:Name="ClustersItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ClusterBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Remove button only -->
                                    <Button Grid.Row="0" 
                                            Content="✕" 
                                            Width="24" 
                                            Height="24" 
                                            HorizontalAlignment="Right"
                                            Background="#CC3333"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="RemoveButton_Click"
                                            Tag="{Binding}" />

                                    <!-- Cluster editor (has its own label) -->
                                    <ContentPresenter Grid.Row="1" 
                                                      Content="{Binding Editor}" 
                                                      Margin="0,5,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="Export BIN"
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Click="Export_Click"/>

            <Button Content="Import BIN"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Click="Import_Click"/>
        </Grid>
    </Grid>
</UserControl>