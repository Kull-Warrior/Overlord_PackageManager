<UserControl x:Class="Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.RawArray.StringEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="EditorBorder" TargetType="Border">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with configurable label and character count -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,5">
            <TextBlock x:Name="HeaderLabel" 
                       Text="Text" 
                       FontWeight="Bold" 
                       FontSize="16" 
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CountBlock" 
                       Margin="20,0,0,0" 
                       Foreground="#888" 
                       VerticalAlignment="Center" 
                       FontSize="12" />
        </StackPanel>

        <!-- Single textbox for the string -->
        <Border Grid.Row="1" Style="{StaticResource EditorBorder}" Margin="10">
            <TextBox x:Name="StringBox" 
                     TextWrapping="Wrap" 
                     MinHeight="100"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="13"
                     MaxLength="{Binding MaxLength, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>
    </Grid>
</UserControl>