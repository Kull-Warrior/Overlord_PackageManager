<UserControl x:Class="Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar.ObjectBoneEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar">
    <UserControl.Resources>
        <Style x:Key="MatrixCellBorder" TargetType="Border">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="5">
        <Label x:Name="MainLabel" FontWeight="Bold" Content="Object Bone" />

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0 -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MatrixCellBorder}">
                <local:TransformEditor x:Name="TransformEditor" Label="Transform" />
            </Border>

            <!-- Row 1 -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MatrixCellBorder}">
                <local:Int32Editor x:Name="ParentIndexEditor" Label="Parent Index" />
            </Border>

            <!-- Row 2 -->
            <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource MatrixCellBorder}">
                <local:Int32Editor x:Name="NextSiblingIndexEditor" Label="Next Sibling Index" />
            </Border>

            <!-- Row 3 -->
            <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource MatrixCellBorder}">
                <local:Int32Editor x:Name="NextTraversalIndexEditor" Label="Next Traversal Index" />
            </Border>

            <!-- Row 4 -->
            <Border Grid.Row="4" Grid.Column="3" Style="{StaticResource MatrixCellBorder}">
                <local:Int32Editor x:Name="ReservedEditor" Label="Reserved" />
            </Border>
        </Grid>
    </StackPanel>
</UserControl>