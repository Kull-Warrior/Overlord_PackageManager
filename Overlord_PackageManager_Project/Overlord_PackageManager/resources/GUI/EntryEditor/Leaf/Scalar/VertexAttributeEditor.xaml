<UserControl x:Class="Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar.VertexAttributeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar">

    <UserControl.Resources>
        <Style x:Key="CellBorder" TargetType="Border">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="5">
        <Label x:Name="MainLabel" FontWeight="Bold" Content="Vertex Attribute" />

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Type -->
            <Border Grid.Column="0" Style="{StaticResource CellBorder}">
                <StackPanel>
                    <TextBlock Text="Type (byte)" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#CCCCCC" />
                    <TextBox x:Name="TypeBox" />
                </StackPanel>
            </Border>

            <!-- Index -->
            <Border Grid.Column="1" Style="{StaticResource CellBorder}">
                <StackPanel>
                    <TextBlock Text="Index (byte)" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#CCCCCC" />
                    <TextBox x:Name="IndexBox" />
                </StackPanel>
            </Border>

            <!-- Semantic -->
            <Border Grid.Column="2" Style="{StaticResource CellBorder}">
                <StackPanel>
                    <TextBlock Text="Semantic" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#CCCCCC" />
                    <ComboBox x:Name="SemanticBox" />
                </StackPanel>
            </Border>

            <!-- ByteSize -->
            <Border Grid.Column="3" Style="{StaticResource CellBorder}">
                <StackPanel>
                    <TextBlock Text="ByteSize" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#CCCCCC" />
                    <ComboBox x:Name="SizeBox" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Raw value display -->
        <TextBlock x:Name="RawBlock"
                   Margin="5,10,0,0"
                   FontFamily="Consolas"
                   Foreground="#888"
                   Text="Raw: 0x00000000" />
    </StackPanel>
</UserControl>