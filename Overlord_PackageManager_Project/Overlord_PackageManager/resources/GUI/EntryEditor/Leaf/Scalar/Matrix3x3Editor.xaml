<UserControl x:Class="Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar.Matrix3x3Editor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar">
    <UserControl.Resources>
        <Style x:Key="MatrixCellBorder" TargetType="Border">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="5">
        <Label x:Name="MainLabel" FontWeight="Bold" Content="Matrix 3x3" />

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0 -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MatrixCellBorder}">
                <local:FloatEditor x:Name="M11Editor" Label="M11" />
            </Border>
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MatrixCellBorder}">
                <local:FloatEditor x:Name="M12Editor" Label="M12" />
            </Border>
            <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource MatrixCellBorder}">
                <local:FloatEditor x:Name="M13Editor" Label="M13" />
            </Border>

            <!-- Row 1 -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MatrixCellBorder}">
                <local:FloatEditor x:Name="M21Editor" Label="M21" />
            </Border>
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MatrixCellBorder}">
                <local:FloatEditor x:Name="M22Editor" Label="M22" />
            </Border>
            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource MatrixCellBorder}">
                <local:FloatEditor x:Name="M23Editor" Label="M23" />
            </Border>

            <!-- Row 2 -->
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource MatrixCellBorder}">
                <local:FloatEditor x:Name="M31Editor" Label="M31" />
            </Border>
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MatrixCellBorder}">
                <local:FloatEditor x:Name="M32Editor" Label="M32" />
            </Border>
            <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource MatrixCellBorder}">
                <local:FloatEditor x:Name="M33Editor" Label="M33" />
            </Border>
        </Grid>
    </StackPanel>
</UserControl>