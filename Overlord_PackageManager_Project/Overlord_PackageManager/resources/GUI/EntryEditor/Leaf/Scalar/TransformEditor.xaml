<UserControl x:Class="Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar.TransformEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar">
    <UserControl.Resources>
        <Style x:Key="MatrixCellBorder" TargetType="Border">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="5">
        <Label x:Name="MainLabel" FontWeight="Bold" Content="Transform" />

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0 -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local:Matrix4x4Editor x:Name="MatrixEditor" Label="Matrix4x4" />
            </Border>

            <!-- Row 1 -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local:QuaternionEditor x:Name="RotationEditor" Label="Rotation" />
            </Border>

            <!-- Row 2 -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local:Vector4Editor x:Name="TranslationEditor" Label="Translation" />
            </Border>
        </Grid>
    </StackPanel>
</UserControl>