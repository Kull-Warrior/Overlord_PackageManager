<UserControl x:Class="Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar.MeshBoneEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.Scalar"
             xmlns:local1="clr-namespace:Overlord_PackageManager.resources.GUI.EntryEditor.Leaf.RawArray">
    <UserControl.Resources>
        <Style x:Key="MatrixCellBorder" TargetType="Border">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="5">
        <Label x:Name="MainLabel" FontWeight="Bold" Content="Mesh Bone" />

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0 -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local1:StringEditor x:Name="NameEditor" Label="Name" MaxLength="32" />
            </Border>

            <!-- Row 1 -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local:MeshTransformEditor x:Name="TransformEditor" Label="Transform" />
            </Border>

            <!-- Row 2 -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local:Int32Editor x:Name="Unknown1Editor" Label="Unknown 1" />
            </Border>

            <!-- Row 3 -->
            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local:Int32Editor x:Name="Unknown2Editor" Label="Unknown 2" />
            </Border>

            <!-- Row 4 -->
            <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local:Int32Editor x:Name="Unknown3Editor" Label="Unknown 3" />
            </Border>

            <!-- Row 5 -->
            <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local:Int32Editor x:Name="Unknown4Editor" Label="Unknown 4" />
            </Border>

            <!-- Row 6 -->
            <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local:Int32Editor x:Name="Unknown5Editor" Label="Unknown 5" />
            </Border>

            <!-- Row 7 -->
            <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource MatrixCellBorder}">
                <local:Int32Editor x:Name="Unknown6Editor" Label="Unknown 6" />
            </Border>
        </Grid>
    </StackPanel>
</UserControl>